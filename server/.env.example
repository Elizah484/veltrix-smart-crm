# Copy this file to ".env" in the same folder and edit the values.
# Never commit ".env" (it is listed in .gitignore).

# --- API server ---
PORT=5000
NODE_ENV=development
# The address the React app runs on. Used for CORS.
CLIENT_ORIGIN=http://localhost:5173

# --- MySQL (XAMPP) ---
DB_HOST=127.0.0.1
# XAMPP's default is 3306. Check the Port column in the XAMPP Control Panel
# (if you changed it, or another MySQL is already using 3306, use that number).
DB_PORT=3306
DB_USER=veltrix_user
# XAMPP's root user has an empty password by default.
DB_PASSWORD='veltrix2026#'
DB_NAME=veltrix_db

# --- Authentication ---
# Use a long random value (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=bc3b55be6e9fa9d1d840ef5ea839c1d1f0d2dd27e4c5c6e235a8f910c89b60a3af436bf1ee6de51ce309f248688ae06b
# How long a sign-in lasts. Examples: 30m, 2h, 1d
JWT_EXPIRES_IN=2h
# Set true when the site is served over HTTPS
COOKIE_SECURE=false
BCRYPT_ROUNDS=10
# Failed sign-ins allowed per IP address in 15 minutes
LOGIN_MAX_ATTEMPTS=10

# --- Demo data ---
# Password that "npm run seed:passwords" gives the four demo accounts
DEMO_PASSWORD=Veltrix#2026

# Let visitors create their own Employee account from the Sign up page. Set to false to turn it off.
ALLOW_SIGNUP=true
